do
    local Players    = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local Workspace  = game:GetService("Workspace")
    local LP         = Players.LocalPlayer

    local FALLBACK_IDS = {
        "8153330984", "17500523791", "8087719701", "16400448844",
        "12543675461", "118877686979518", "8232354818", "17896975920",
        "78372165320140", "792827145228",
    }

    local DodgeConfig = {
        Enabled          = false,
        Range            = 25,
        Mode             = "Side",
        DodgeDistance    = 8,
        Cooldown         = 0.6,
        ScanInterval     = 0.05,
        BackJumpDuration = 1.2,
        BackJumpMinDist  = 15,
    }

    local DodgeState = {
        LastDodge = 0,
        LastScan  = 0,
        Running   = false,
    }

    local function getIds()
        local g = getgenv().YingAttackAnimIds
        if type(g) == "table" and #g > 0 then return g end
        return FALLBACK_IDS
    end

    local function getHRP()
        local c = LP.Character
        return c and c:FindFirstChild("HumanoidRootPart")
    end

    local function getHum()
        local c = LP.Character
        return c and c:FindFirstChildOfClass("Humanoid")
    end

    local function isAnimAttacking(model)
        if model == LP.Character then return false end
        local hum = model:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return false end
        local animator = hum:FindFirstChildOfClass("Animator")
        if not animator then return false end
        local ids = getIds()
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            local id = track.Animation and track.Animation.AnimationId
            if id then
                local pure = id:match("%d+")
                if pure then
                    for _, target in ipairs(ids) do
                        if pure == tostring(target) then return true end
                    end
                end
            end
        end
        return false
    end

    local function backJumpRun(backDir, startPos)
        local hum = getHum()
        if not hum then return end

        DodgeState.Running = true
        local endTime = tick() + DodgeConfig.BackJumpDuration
        local minDistSq = DodgeConfig.BackJumpMinDist * DodgeConfig.BackJumpMinDist

        task.spawn(function()
            while tick() < endTime do
                local h = getHum()
                if not h or h.Health <= 0 then break end
                local hrp = getHRP()
                if not hrp then break end

                h:Move(backDir, false)

                if h.FloorMaterial ~= Enum.Material.Air then
                    h:ChangeState(Enum.HumanoidStateType.Jumping)
                end

                local d = hrp.Position - startPos
                if d:Dot(d) >= minDistSq then break end

                RunService.Heartbeat:Wait()
            end
            local h = getHum()
            if h then h:Move(Vector3.zero, false) end
            DodgeState.Running = false
        end)
    end

    local function tryDodge(attackerPos)
        if DodgeState.Running then return end

        local now = tick()
        if now - DodgeState.LastDodge < DodgeConfig.Cooldown then return end

        local hrp = getHRP()
        local hum = getHum()
        if not hrp or not hum or hum.Health <= 0 then return end

        local myPos = hrp.Position
        local toAttacker = (attackerPos - myPos) * Vector3.new(1, 0, 1)
        if toAttacker.Magnitude < 0.1 then return end
        toAttacker = toAttacker.Unit

        if DodgeConfig.Mode == "Jump" then
            DodgeState.LastDodge = now
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
            return
        end

        if DodgeConfig.Mode == "BackJump" then
            DodgeState.LastDodge = now
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
            backJumpRun(-toAttacker, myPos)
            return
        end

        DodgeState.LastDodge = now
        local dodgeDir
        if DodgeConfig.Mode == "Back" then
            dodgeDir = -toAttacker
        else
            local side = math.random(0, 1) == 0 and 1 or -1
            dodgeDir = Vector3.new(-toAttacker.Z, 0, toAttacker.X) * side
        end

        local target = myPos + dodgeDir * DodgeConfig.DodgeDistance
        hrp.CFrame = CFrame.new(target) * (hrp.CFrame - hrp.CFrame.Position)
        hrp.AssemblyLinearVelocity  = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end

    local function scan()
        if not DodgeConfig.Enabled then return end
        if DodgeState.Running then return end

        local now = tick()
        if now - DodgeState.LastScan < DodgeConfig.ScanInterval then return end
        DodgeState.LastScan = now

        local hrp = getHRP()
        if not hrp then return end
        local myPos = hrp.Position
        local rangeSq = DodgeConfig.Range * DodgeConfig.Range

        local folders = {
            Workspace:FindFirstChild("Characters"),
            Workspace:FindFirstChild("Teachers"),
            Workspace:FindFirstChild("NPCs"),
            Workspace:FindFirstChild("Alices"),
        }

        for _, folder in ipairs(folders) do
            if folder then
                for _, model in ipairs(folder:GetChildren()) do
                    if model:IsA("Model") and model ~= LP.Character then
                        local root = model:FindFirstChild("HumanoidRootPart")
                                  or model:FindFirstChild("Torso")
                        if root then
                            local d = root.Position - myPos
                            if d:Dot(d) <= rangeSq and isAnimAttacking(model) then
                                tryDodge(root.Position)
                                return
                            end
                        end
                    end
                end
            end
        end
    end

    RunService.Heartbeat:Connect(scan)

   local DodgeTab = Window:Tab({ Title = T("自动闪避", "Auto Dodge"), Icon = "shield" })

