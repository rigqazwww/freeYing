    local instanceHandle = getrenv and getrenv().InstanceHandle
    local hasInstanceHandle = instanceHandle ~= nil
    if type(sethiddenproperty) == "function" then
        local originalSetHiddenProperty = sethiddenproperty
        sethiddenproperty = function(part, property, value, ...)
            if property == "PhysicsRepRootPart" then
                if hasInstanceHandle then
                    pcall(originalSetHiddenProperty, part, "PhysicsRepRootRef", instanceHandle.new(value))
                end
            end
            return originalSetHiddenProperty(part, property, value, ...)
        end
    end

    local function FindNearest(myPos, myChar)
        local rangeSq = CONFIG.Range * CONFIG.Range
        local wlActive = hasWhitelist()
        local best, bestD2

        local function try(model)
            if model == myChar or not model:IsA("Model") then return end
            if wlActive and not isWhitelisted(model.Name) then return end
            local hum, root = GetRefs(model)
            if not hum or hum.Health <= 0 or not root or not root.Parent then return end
            local offset = root.Position - myPos
            local d2 = offset:Dot(offset)
            if d2 <= rangeSq and (not bestD2 or d2 < bestD2) then
                best, bestD2 = model, d2
            end
        end

        if CONFIG.TargetPlayers then
            local folder = getCharsFolder()
            if folder then for _, m in ipairs(folder:GetChildren()) do try(m) end end
        end
        if CONFIG.TargetNPCs then
            local folder = getNpcsFolder()
            if folder then for _, m in ipairs(folder:GetChildren()) do try(m) end end
        end
        return best
    end

