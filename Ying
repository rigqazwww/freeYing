    local Workspace         = game:GetService("Workspace")
    local LP                = Players.LocalPlayer

    local MeleeConfig = {
        ReachEnabled         = false,
        ReachDistance        = 20,
        HitCooldownReduction = true,
        TargetMode           = "病人模式",
    }

    local function isEligible(pl)
        if not pl or pl == LP then return false end
        if hasWhitelist() and not isWhitelisted(pl.Name) then return false end
        
        local tName = pl.Team and pl.Team.Name or ""
        local isPatient = (tName == "PATIENT" or tName == "PATIENTS")

        if MeleeConfig.TargetMode == "病人模式" then
            return true
        end

        -- 守卫模式：只打敌对病人（假设你站在守卫/非病人视角）
        if MeleeConfig.TargetMode == "守卫模式" then
            return isPatient
        end

        return false
    end

    local function getClosestTarget(originPos, maxDist)
        local chars   = Workspace:FindFirstChild("Characters")
        local bestPart, bestHum
        local maxSq   = maxDist * maxDist
        local maxFar  = (maxDist + 50) * (maxDist + 50)

        for _, pl in ipairs(Players:GetPlayers()) do
            if isEligible(pl) then
                local ch = pl.Character or (chars and chars:FindFirstChild(pl.Name))
                if ch and ch.Parent then
                    local hum = ch:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        local root = ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChild("Torso")
                        local skip = false
                        if root then
                            local dp = root.Position - originPos
                            if dp:Dot(dp) > maxFar then skip = true end
                        end
                        if not skip then
                            local part = ch:FindFirstChild("Head")
                                      or ch:FindFirstChild("HumanoidRootPart")
                                      or ch:FindFirstChild("Torso")
                                      or ch:FindFirstChild("UpperTorso")
                            if part then
                                local dp = part.Position - originPos
                                local d2 = dp:Dot(dp)
                                if d2 <= maxSq then
                                    bestPart = part
                                    bestHum  = hum
                                    maxSq    = d2
                                end
                            end
                        end
                    end
                end
            end
        end
        return bestPart, bestHum
    end

    local function processHit(hitbox, result)
        if not (hitbox and result and result.Instance) then return end
        local inst  = result.Instance
        local cache = hitbox._Cache and hitbox._Cache.Hits
        if cache and not cache[inst] then
            local model = inst:FindFirstAncestorOfClass("Model")
            local hum = nil
            if model and not model:HasTag("Drone") then
                hum = model:FindFirstChildOfClass("Humanoid")
            end
            if hitbox.OnHit then
                pcall(function() hitbox.OnHit:Fire(inst, hum, result) end)
            end
            cache[inst] = true
        end
    end

    -- Hook AttachmentSolver
    task.spawn(function()
        if typeof(hookfunction) ~= "function" then
            warn("[Melee] hookfunction not available")
            return
        end
        local ok, solver = pcall(function()
            local mod = ReplicatedStorage:WaitForChild("Module", 15)
            if not mod then return nil end
            local rh = mod:WaitForChild("RaycastHitbox", 15)
            if not rh then return nil end
            local s = rh:WaitForChild("AttachmentSolver", 15)
            if not s then return nil end
            return require(s)
        end)
        if not ok or typeof(solver) ~= "function" then
            warn("[Melee] RaycastHitbox.AttachmentSolver not found")
            return
        end

        local oldSolver
        oldSolver = hookfunction(solver, newcclosure(function(hitbox, attachment)
            if not (hitbox and attachment and attachment.Parent) then
                return oldSolver(hitbox, attachment)
            end

            local lastMap  = hitbox._LastPositions
            local worldPos = attachment.WorldPosition
            local lastPos  = (lastMap and lastMap[attachment]) or worldPos
            local delta    = worldPos - lastPos

            if worldPos ~= lastPos then
                local ok2, result = pcall(function()
                    return Workspace:Raycast(lastPos, delta, hitbox.RaycastParams)
                end)
                if ok2 and result and result.Instance then
                    processHit(hitbox, result)
                end
            end

            if MeleeConfig.HitCooldownReduction and hitbox._Cache
            and typeof(hitbox._Cache.Hits) == "table" then
                table.clear(hitbox._Cache.Hits)
            end

            if MeleeConfig.ReachEnabled and hitbox.HitboxActive then
                local myChar = LP.Character
                if myChar and attachment:IsDescendantOf(myChar) then
                    local part, hum = getClosestTarget(worldPos, MeleeConfig.ReachDistance)
                    if part and hum then
                        local fakeResult = {
                            Instance = part,
                            Position = part.Position,
                            Normal   = Vector3.new(0, 1, 0),
                            Material = Enum.Material.Plastic,
                            Distance = (part.Position - worldPos).Magnitude,
                        }
                        processHit(hitbox, fakeResult)
                    end
                end
            end

            if lastMap then lastMap[attachment] = worldPos end
            return lastPos, worldPos, delta
        end))

        print("[Melee] Reach + HitCooldown hook installed")
    end)

    pcall(function()
        if KillTab and KillTab.Toggle then
            KillTab:Divider()
