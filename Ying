do
    local Players     = game:GetService("Players")
    local RunService  = game:GetService("RunService")
    local HttpService = game:GetService("HttpService")
    local LocalPlayer = Players.LocalPlayer

    local req      = (syn and syn.request) or (http and http.request) or http_request or request
    local getasset = getcustomasset or getsynasset
    if not req or not getasset or not writefile or not readfile then
        warn("[Music] 环境缺少 API，跳过音乐模块")
        return
    end

    local DataFolder = "YingMusic_Data"
    if not isfolder(DataFolder) then makefolder(DataFolder) end
    if getgenv()._CleanYingMusic then pcall(getgenv()._CleanYingMusic) end

    local function formatTime(sec)
        sec = math.max(0, math.floor(sec or 0))
        return string.format("%d:%02d", math.floor(sec / 60), sec % 60)
    end

    local FakeHeaders = {
        ["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36",
        ["Referer"]    = "https://music.163.com/",
    }
    local function httpGet(url, headers)
        local ok, res = pcall(function()
            return req({ Url = url, Method = "GET", Headers = headers or FakeHeaders })
        end)
        if not ok or not res then return nil, "request failed" end
        local body = res.Body or res.body
        local status = res.StatusCode or res.code or res.status or 0
        return body, status
    end

    local Netease = {}
    function Netease.search(kw, page, limit)
        limit = limit or 15; page = page or 1
        local offset = (page - 1) * limit
        local url = "https://music.163.com/api/search/get/web?s=" .. HttpService:UrlEncode(kw)
            .. "&type=1&limit=" .. limit .. "&offset=" .. offset
        local songs
        for attempt = 1, 3 do
            local body, status = httpGet(url)
            if body and status == 200 then
                local ok, d = pcall(function() return HttpService:JSONDecode(body) end)
                if ok and d and d.result then
                    songs = {}
                    for _, s in ipairs(d.result.songs or {}) do
                        songs[#songs + 1] = {
                            id = s.id, name = s.name, artists = s.artists,
                            album = s.album and s.album.name or "",
                            duration = s.duration or 0, fee = s.fee or 0, source = "netease",
                        }
                    end
                    table.sort(songs, function(a, b) return (a.fee or 0) < (b.fee or 0) end)
                    return songs, false
                end
                if ok and d and d.code == -462 then task.wait(1.2 * attempt)
                else return nil, false end
            else return nil, false end
        end
        return nil, true
    end
    function Netease.songUrl(id)
        local url = "https://music.163.com/api/song/enhance/player/url?id=" .. id
            .. "&ids=%5B" .. id .. "%5D&br=320000"
        local body, status = httpGet(url)
        if not body or status ~= 200 then return nil end
        local ok, d = pcall(function() return HttpService:JSONDecode(body) end)
        if not ok or not d or not d.data or #d.data == 0 then return nil end
        local it = d.data[1]
        if not it or it.code ~= 200 or not it.url or it.url == "" then return nil end
        return it.url
    end
    function Netease.lyric(id)
        local url = "http://music.163.com/api/song/lyric?id=" .. id .. "&lv=-1&kv=-1&tv=-1"
        local body, status = httpGet(url)
        if not body or status ~= 200 then return nil end
        local ok, d = pcall(function() return HttpService:JSONDecode(body) end)
        if not ok or not d then return nil end
        if d.lrc and d.lrc.lyric then return d.lrc.lyric end
        return nil
    end
    function Netease.playlist(id)
        local url = "http://music.163.com/api/playlist/detail?id=" .. id
        local body, status = httpGet(url)
        if not body or status ~= 200 then return nil end
        local ok, d = pcall(function() return HttpService:JSONDecode(body) end)
        if not ok or not d or not d.result then return nil end
        local tracks = {}
        for _, t in ipairs(d.result.tracks or {}) do
            tracks[#tracks + 1] = {
                id = t.id, name = t.name, artists = t.artists,
                album = t.album and t.album.name or "",
                duration = t.duration or 0, fee = t.fee or 0, source = "netease",
            }
        end
        return { name = d.result.name or "", tracks = tracks }
    end

    local Kuwo = {}
    local function decodeHtml(s)
        s = s or ""
        return s:gsub("&nbsp;", " "):gsub("&amp;", "&"):gsub("&lt;", "<"):gsub("&gt;", ">")
                :gsub("&quot;", '"'):gsub("&#39;", "'")
    end
    function Kuwo.search(kw, page, limit)
        limit = limit or 20; page = page or 1
        local offset = (page - 1) * limit
        local url = "http://search.kuwo.cn/r.s?all=" .. HttpService:UrlEncode(kw)
            .. "&ft=music&itemset=web_2013&client=kt&pn=" .. offset .. "&rn=" .. limit
            .. "&rformat=json&encoding=utf8"
        local body, status = httpGet(url)
        if not body or status ~= 200 or body == "" then return nil end
        local json = body:gsub("'", '"')
        local ok, d = pcall(function() return HttpService:JSONDecode(json) end)
        if not ok or not d or not d.abslist then return nil end
        local songs = {}
        for _, s in ipairs(d.abslist) do
            local rid = s.MUSICRID or ""
            songs[#songs + 1] = {
                id = rid:gsub("MUSIC_", ""), name = decodeHtml(s.SONGNAME) or "未知歌曲",
                artists = { { name = decodeHtml(s.ARTIST) or "未知歌手" } },
                album = decodeHtml(s.ALBUM) or "",
                duration = tonumber(s.DURATION or 0) * 1000, fee = 0, source = "kuwo",
            }
        end
        return songs
    end
    function Kuwo.songUrl(id)
        local rid = "MUSIC_" .. tostring(id)
        local url = "http://antiserver.kuwo.cn/anti.s?type=convert_url&format=mp3&response=url&rid=" .. rid
        local body, status = httpGet(url)
        if body and status == 200 then
            body = body:gsub("%s+", "")
            if body:find("http") then return body end
        end
        return nil
    end
    function Kuwo.lyric(id)
        local url = "http://m.kuwo.cn/newh5/singles/songinfoandlrc?musicId=" .. tostring(id) .. "&httpsStatus=1"
        local body, status = httpGet(url)
        if not body or status ~= 200 then return nil end
        local ok, d = pcall(function() return HttpService:JSONDecode(body) end)
        if not ok or not d or not d.data or not d.data.lrclist then return nil end
        local lines = {}
        for _, l in ipairs(d.data.lrclist) do
            local t = tonumber(l.time or 0)
            lines[#lines + 1] = string.format("[%02d:%05.2f]%s", math.floor(t / 60), t % 60, l.lineLyric or "")
        end
        return table.concat(lines, "\n")
    end

    local QqMusic = {}
    local QqHeaders = { ["User-Agent"] = FakeHeaders["User-Agent"], ["Referer"] = "https://y.qq.com/" }
    function QqMusic.search(kw, page, limit)
        limit = limit or 20; page = page or 1
        local url = "https://c.y.qq.com/soso/fcgi-bin/client_search_cp?w=" .. HttpService:UrlEncode(kw)
            .. "&format=json&p=" .. page .. "&n=" .. limit .. "&cr=1&new_json=1"
        local body, status = httpGet(url, QqHeaders)
        if not body or status ~= 200 then return nil end
        local ok, d = pcall(function() return HttpService:JSONDecode(body) end)
        if not ok or not d or d.code ~= 0 then return nil end
        local list = d.data and d.data.song and d.data.song.list or {}
        local songs = {}
        for _, s in ipairs(list) do
            local singers = {}
            for _, sg in ipairs(s.singer or {}) do singers[#singers + 1] = { name = sg.name or "未知歌手" } end
            songs[#songs + 1] = {
                id = s.mid, name = s.name or "未知歌曲", artists = singers,
                album = s.album and s.album.name or "",
                duration = (s.interval or 0) * 1000,
                fee = s.pay and s.pay.pay_play or 0, source = "qq",
            }
        end
        table.sort(songs, function(a, b) return (a.fee or 0) < (b.fee or 0) end)
        return songs
    end
    function QqMusic.songUrl(mid)
        local payload = HttpService:JSONEncode({
            req_0 = { module = "vkey.GetVkeyServer", method = "CgiGetVkey", param = {
                guid = "10000", songmid = { mid }, filename = { "M500" .. mid .. ".mp3" },
                songtype = { 0 }, uin = "0", platform = "20" } },
            comm = { uin = 0, format = "json" },
        })
        local url = "https://u.y.qq.com/cgi-bin/musicu.fcg?data=" .. HttpService:UrlEncode(payload)
        local body, status = httpGet(url, QqHeaders)
        if not body or status ~= 200 then return nil end
        local ok, d = pcall(function() return HttpService:JSONDecode(body) end)
        if not ok or not d or not d.req_0 or d.req_0.code ~= 0 then return nil end
        local r = d.req_0.data
        if not r then return nil end
        local info = r.midurlinfo and r.midurlinfo[1]
        if not info or not info.purl or info.purl == "" then return nil end
        return (r.sip and r.sip[1] or "http://aqqmusic.tc.qq.com/") .. info.purl
    end
    function QqMusic.lyric(mid)
        local url = "https://c.y.qq.com/lyric/fcgi-bin/fcg_query_lyric_new.fcg?songmid=" .. mid
            .. "&format=json&nobase64=1"
        local body, status = httpGet(url, QqHeaders)
        if not body or status ~= 200 then return nil end
        local ok, d = pcall(function() return HttpService:JSONDecode(body) end)
        if not ok or not d or not d.lyric or d.lyric == "" then return nil end
        return d.lyric
    end

    local Sources = {
        { key = "netease", name = "网易云" },
        { key = "kuwo",    name = "酷我" },
        { key = "qq",      name = "QQ音乐" },
    }

    local MetaKeywords = { "作词","作曲","编曲","制作人","混音","录音","母带","和声","吉他","贝斯","鼓","键盘","监制","弦乐","出品","发行" }
    local function parseLrc(lrc)
        local out = {}
        for minutes, seconds, text in (lrc or ""):gmatch("%[(%d+):(%d+%.?%d*)%]([^\r\n]*)") do
            local t = tonumber(minutes) * 60 + tonumber(seconds)
            text = (text or ""):gsub("^%s+", ""):gsub("%s+$", "")
            if text ~= "" then
                local skip = false
                for _, k in ipairs(MetaKeywords) do if text:find(k, 1, true) then skip = true; break end end
                if not skip then out[#out + 1] = { time = t, text = text } end
            end
        end
        table.sort(out, function(a, b) return a.time < b.time end)
        return out
    end

    local State = {
        Queue = {}, QueueIndex = 0, CurrentSong = nil,
        Lyrics = {}, CurLyricIdx = 0,
        LoopMode = 1, Source = "kuwo",
        SearchResults = {}, SearchIndexMap = {},
    }
    local Audio = Instance.new("Sound")
    Audio.Volume = 0.8
    Audio.Parent = game:GetService("SoundService")

    local function songNameOf(s) return s and s.name or "未知歌曲" end
    local function artistNameOf(s)
        if not s or not s.artists or #s.artists == 0 then return "未知歌手" end
        local names = {}
        for _, a in ipairs(s.artists) do names[#names + 1] = a.name end
        return table.concat(names, " / ")
    end

    local function downloadAudio(url)
        local candidates = { url }
        if url:sub(1, 7) == "http://" then candidates[2] = "https://" .. url:sub(8) end
        for _, u in ipairs(candidates) do
            local body, status = httpGet(u)
            if body and #body > 1000 then return body, status end
        end
        return nil, nil
    end
    local function getSongUrl(song)
        if not song then return nil end
        if song.source == "kuwo" then return Kuwo.songUrl(song.id) end
        if song.source == "qq" then return QqMusic.songUrl(song.id) end
        return Netease.songUrl(song.id)
    end
    local function getLyric(song)
        if not song then return nil end
        if song.source == "kuwo" then return Kuwo.lyric(song.id) end
        if song.source == "qq" then return QqMusic.lyric(song.id) end
        return Netease.lyric(song.id)
    end

    local function notify(title, content, dur)
        pcall(function()
            WindUI:Notify({ Title = title, Content = content, Duration = dur or 2 })
        end)
    end

    local function playSong(song, appendQueue)
        Audio:Stop()
        if appendQueue then State.Queue[#State.Queue + 1] = song end
        State.CurrentSong = song
        State.Lyrics = {}; State.CurLyricIdx = 0
        notify("正在解析", songNameOf(song), 2)

        task.spawn(function()
            local ok, err = pcall(function()
                local url = getSongUrl(song)
                if not url then
                    notify("播放失败", "获取链接失败（可能需 VIP 或版权受限）")
                    return
                end
                local body = downloadAudio(url)
                if not body then notify("播放失败", "音频下载失败"); return end
                if State.CurrentSong and State.CurrentSong.id ~= song.id then return end
                local fname = DataFolder .. "/Track_" .. (song.source or "netease")
                    .. "_" .. tostring(song.id) .. ".mp3"
                writefile(fname, body)
                Audio.SoundId = getasset(fname)
                local lrc = getLyric(song)
                if lrc then State.Lyrics = parseLrc(lrc) end
                Audio:Play()
                notify("正在播放", songNameOf(song), 2)
            end)
            if not ok then notify("播放出错", tostring(err)) end
        end)
    end

    local PlayerCtrl = {}
    function PlayerCtrl.playSong(song, appendQueue) playSong(song, appendQueue) end
    function PlayerCtrl.next()
        if #State.Queue == 0 then return end
        if State.LoopMode == 3 and #State.Queue > 1 then
            State.QueueIndex = math.random(1, #State.Queue)
        else
            State.QueueIndex = State.QueueIndex % #State.Queue + 1
        end
        playSong(State.Queue[State.QueueIndex])
    end
    function PlayerCtrl.prev()
        if #State.Queue == 0 then return end
        State.QueueIndex = (State.QueueIndex - 2 + #State.Queue) % #State.Queue + 1
        playSong(State.Queue[State.QueueIndex])
    end
    function PlayerCtrl.playQueue(songs, startIndex)
        State.Queue = songs or {}
        State.QueueIndex = startIndex or 1
        if #State.Queue == 0 then return end
        playSong(State.Queue[State.QueueIndex])
    end
    function PlayerCtrl.togglePlay()
        if Audio.IsPlaying then
            Audio:Pause()
        elseif Audio.TimeLength > 0 then
            Audio:Resume()
        end
    end

    getgenv().YingMusic = {
        State = State, Audio = Audio, PlayerCtrl = PlayerCtrl,
        playSong = playSong, formatTime = formatTime,
    }

    Audio.Ended:Connect(function()
        if State.LoopMode == 2 and State.CurrentSong then
            Audio.TimePosition = 0; Audio:Play()
        elseif State.CurrentSong then
            if #State.Queue > 1 then PlayerCtrl.next()
            else Audio.TimePosition = 0; Audio:Play() end
        end
    end)

    local MusicTab = Window:Tab({ Title = T("音乐", "Music"), Icon = "music" })

    MusicTab:Paragraph({
        Title = T("音乐播放器", "Music Player"),
        Desc  = T("支持 网易云 / 酷我 / QQ音乐 · 无独立窗口",
                  "NetEase / Kuwo / QQ · No standalone window"),
    })
    MusicTab:Divider()

    MusicTab:Dropdown({
        Title = T("音源", "Source"),
        Desc  = T("选择搜索来源", "Choose search source"),
        Values = { "网易云", "酷我", "QQ音乐" },
        Value = "酷我",
        Callback = function(v)
            for _, src in ipairs(Sources) do
                if src.name == v then State.Source = src.key; break end
            end
        end,
    })

    local lastQuery = ""
    local searchInput = MusicTab:Input({
        Title = T("搜索关键词", "Search Keyword"),
        Desc  = T("歌名 / 歌手 / 专辑", "Song / Artist / Album"),
        Placeholder = "青衣",
        Callback = function(text) lastQuery = text or "" end,
    })

    local function getInputText(obj, fallback)
        if not obj then return fallback or "" end
        local v
        pcall(function() v = obj:Get() end)
        if type(v) == "string" and v ~= "" then return v end
        pcall(function() v = obj.Value end)
        if type(v) == "string" and v ~= "" then return v end
        pcall(function() v = obj.Text end)
        if type(v) == "string" and v ~= "" then return v end
        return fallback or ""
    end

    local resultDropdown = MusicTab:Dropdown({
        Title = T("搜索结果", "Search Results"),
        Desc  = T("选择歌曲播放", "Click a song to play"),
        Values = {},
        Value = "",
        Callback = function(selected)
            if not selected or selected == "" then return end
            local song = State.SearchIndexMap[selected]
            if song then
                for i, s in ipairs(State.SearchResults) do
                    if s == song then
                        PlayerCtrl.playQueue(State.SearchResults, i)
                        return
                    end
                end
            end
        end,
    })

    local function refreshResultDropdown()
        local labels = {}
        State.SearchIndexMap = {}
        for i, s in ipairs(State.SearchResults) do
            local label = string.format("%d. %s - %s", i, s.name, artistNameOf(s))
            labels[i] = label
            State.SearchIndexMap[label] = s
        end
        pcall(function() resultDropdown:Refresh(labels) end)
        pcall(function() resultDropdown:SetValues(labels) end)
        pcall(function() resultDropdown.Values = labels end)
    end

    local function doSearch()
        local kw = getInputText(searchInput, lastQuery)
        kw = (kw or ""):gsub("^%s+", ""):gsub("%s+$", "")
        if kw == "" then notify(T("搜索", "Search"), T("请输入关键词", "Please enter keyword")); return end
        notify(T("搜索中", "Searching"), kw, 2)
        task.spawn(function()
            local songs, blocked
            if State.Source == "kuwo" then songs = Kuwo.search(kw, 1, 20)
            elseif State.Source == "qq" then songs = QqMusic.search(kw, 1, 20)
            else songs, blocked = Netease.search(kw, 1, 20) end
            State.SearchResults = songs or {}
