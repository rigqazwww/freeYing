local contrabandData = {}

local contrabandBlacklist = {
	["Metal Bat"] = true,
	["Baseball Bat"] = true,
	["Heist"] = true,
	["Fireaxe"] = true,
	["Crates"] = true,
	["Shipping Crate"] = true,
}

local contrabandRoot = nil

local function contrabandPart(obj)
	if obj:IsA("BasePart") then
		return obj
	end
	return obj:FindFirstChildWhichIsA("BasePart", true)
end

local function removeContrabandESP(obj)
	local data = contrabandData[obj]
	if not data then return end
	contrabandData[obj] = nil
	if data.Conn then
		pcall(function() data.Conn:Disconnect() end)
	end
	if data.Highlight then
		pcall(function() data.Highlight:Destroy() end)
	end
	if data.Billboard then
		pcall(function() data.Billboard:Destroy() end)
	end
end

local function createContrabandESP(obj)
	if not (obj and obj.Parent) then return end

	if contrabandBlacklist[obj.Name] then
		removeContrabandESP(obj)
		return
	end

	local part = contrabandPart(obj)
	if not part then return end

	removeContrabandESP(obj)

	local color = ESPConfig.ContrabandColor or Color3.fromRGB(255, 60, 60)

	local hl = Instance.new("Highlight")
	hl.Name                = "_YingContrabandHL"
	hl.Adornee             = obj
	hl.FillColor           = color
	hl.FillTransparency    = 0.5
	hl.OutlineColor        = Color3.fromRGB(255, 255, 255)
	hl.OutlineTransparency = 0
	hl.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Enabled             = ESPConfig.ContrabandESP
	hl.Parent              = part

	local bb = Instance.new("BillboardGui")
	bb.Name         = "_YingContrabandESP"
	bb.Adornee      = part
	bb.Size         = UDim2.new(0, 200, 0, 30)
	bb.StudsOffset  = Vector3.new(0, 2, 0)
	bb.AlwaysOnTop  = true
	bb.MaxDistance  = math.huge
	bb.ResetOnSpawn = false
	bb.Enabled      = ESPConfig.ContrabandESP
	bb.Parent       = getGuiContainer()

	local label = Instance.new("TextLabel")
	label.Size                   = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Text                   = "违禁品: " .. obj.Name
	label.TextColor3             = color
	label.TextStrokeColor3       = Color3.fromRGB(0, 0, 0)
	label.TextStrokeTransparency = 0.4
	label.TextSize               = 14
	label.Font                   = Enum.Font.SourceSansBold
	label.Parent                 = bb

	local entry = {
		Highlight = hl,
		Billboard = bb,
		Label     = label,
		Part      = part,
		Name      = obj.Name,
		Root      = contrabandRoot,
	}

	entry.Conn = obj.AncestryChanged:Connect(function()
		if not obj.Parent then
			removeContrabandESP(obj)
		elseif entry.Root and entry.Root.Parent and not obj:IsDescendantOf(entry.Root) then
			removeContrabandESP(obj)
		end
	end)

	contrabandData[obj] = entry
end

local function isGhost(obj, part)
	if ESPConfig.ContrabandHideGhost == false then return false end
	if obj:IsA("BasePart") then
		return obj.Transparency >= 1
	end
	if part.Transparency < 1 then return false end
	for _, p in ipairs(obj:GetDescendants()) do
		if p:IsA("BasePart") and p.Transparency < 1 then
			return false
		end
	end
	return true
end

local function sweepContraband()
	for obj, data in pairs(contrabandData) do
		local gone = not obj.Parent
		if not gone and data.Root and data.Root.Parent then
			gone = not obj:IsDescendantOf(data.Root)
		end

		if gone then
			removeContrabandESP(obj)
		else
			local part = contrabandPart(obj)
			if not part then
				if data.Highlight then data.Highlight.Enabled = false end
				if data.Billboard then data.Billboard.Enabled = false end
				data.Part = nil
			elseif isGhost(obj, part) then
				removeContrabandESP(obj)
			elseif part ~= data.Part then
				createContrabandESP(obj)
			end
		end
	end
end

function refreshContrabandESP()
	local color = ESPConfig.ContrabandColor or Color3.fromRGB(255, 60, 60)
	sweepContraband()
	for obj, data in pairs(contrabandData) do
		if data.Highlight then
			data.Highlight.Enabled   = ESPConfig.ContrabandESP
			data.Highlight.FillColor = color
		end
		if data.Billboard then
			data.Billboard.Enabled = ESPConfig.ContrabandESP
		end
		if data.Label then
			data.Label.TextColor3 = color
		end
	end
end

