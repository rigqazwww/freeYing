end)

local Workspace = game:GetService("Workspace")
local trashCanData         = {}
local TRASH_GREEN_FILL     = Color3.fromRGB(34, 197, 94)
local TRASH_GREEN_OUTLINE  = Color3.fromRGB(74, 222, 128)
local TRASH_YELLOW_FILL    = Color3.fromRGB(250, 204, 21)
local TRASH_YELLOW_OUTLINE = Color3.fromRGB(253, 224, 71)
local TRASH_COOLDOWN       = 5

local trashCanContainer = (function()
    local parent = getGuiContainer()
    local folder
    local ok = pcall(function()
        folder = Instance.new("Folder")
        folder.Name = "_YingTrashCanESP"
        folder.Parent = parent
    end)
    if ok and folder then return folder end
    return nil
end)()

local function removeTrashCanESP(model)
    local data = trashCanData[model]
    if data then
        if data.Highlight and data.Highlight.Parent then
            pcall(function() data.Highlight:Destroy() end)
        end
        trashCanData[model] = nil
    end
end

local function createTrashCanESP(model)
    if not (model and model.Parent and model:IsA("Model") and model.Name == "TrashCan") then return end
    removeTrashCanESP(model)

    local base = model:FindFirstChild('Base') or model.PrimaryPart
              or model:FindFirstChildWhichIsA('BasePart')

    local hl = Instance.new('Highlight')
    hl.Name               = '_YingTrashCanHighlight'
    hl.Adornee            = model
    hl.FillColor          = TRASH_GREEN_FILL
    hl.FillTransparency   = 0.5
    hl.OutlineColor       = TRASH_GREEN_OUTLINE
    hl.OutlineTransparency= 0
    hl.DepthMode          = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Enabled            = ESPConfig.TrashCanESP
    hl.Parent             = trashCanContainer or model

    trashCanData[model] = {
        Highlight = hl, Model = model, Part = base,
        IsChecked = false, Sequence = 0,
    }
end

local function markTrashCanChecked(model, cooldown)
    if not (model and model.Parent) then return end

    -- 容忍传入子对象：向上寻找 TrashCan（逐级 Parent，不要用 FindFirstAncestorWhichIsA）
    if not (model:IsA("Model") and model.Name == "TrashCan") then
        local m = model
        while m do
            if m:IsA("Model") and m.Name == "TrashCan" then
                model = m
                break
            end
            m = m.Parent
        end
        if not (model:IsA("Model") and model.Name == "TrashCan") then return end
    end

    local data = trashCanData[model]
    if not (data and data.Highlight and data.Highlight.Parent) then
        createTrashCanESP(model)
        data = trashCanData[model]
    end
    if not (data and data.Highlight and data.Highlight.Parent) then return end

    data.IsChecked              = true
    data.Highlight.FillColor    = TRASH_YELLOW_FILL
    data.Highlight.OutlineColor = TRASH_YELLOW_OUTLINE
