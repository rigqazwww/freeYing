    local err
    for i, u in ipairs(urls) do
        local okH, body = pcall(function() return game:HttpGet(u .. "?cb=" .. tostring(os.time()), true) end)
        if okH and type(body) == "string" and #body > 500 then
            local chunk, cErr = loadstring(body)
