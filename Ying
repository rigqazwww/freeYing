        elseif CONFIG.Mode == "前方" then
            newPos = (targetCFrame * CFrame.new(0, 0, -dist)).Position
        elseif CONFIG.Mode == "后方" then
            newPos = (targetCFrame * CFrame.new(0, 0, dist)).Position
        elseif CONFIG.Mode == "环绕" then
            
            local now = tick()
            local delta = now - STATE.LastTime
            STATE.LastTime = now
            if delta > 0.5 then delta = 0 end
            STATE.OrbitAngle = (STATE.OrbitAngle + math.rad(CONFIG.OrbitSpeed) * delta) % (2 * math.pi)

            local localX = math.cos(STATE.OrbitAngle) * CONFIG.OrbitRadius
            local localZ = math.sin(STATE.OrbitAngle) * CONFIG.OrbitRadius
            newPos = (targetCFrame * CFrame.new(localX, 0, localZ)).Position
        else
            newPos = targetCFrame.Position
        end

        rootPart.CFrame = CFrame.lookAt(newPos, targetRootPart.Position)
        
        rootPart.AssemblyLinearVelocity = Vector3.zero
        rootPart.AssemblyAngularVelocity = Vector3.zero
    end)

