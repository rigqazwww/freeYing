        if not rootPart or not targetRootPart or not hum then return end
        if dt <= 0 then return end
        if dt > 0.1 then dt = 0.1 end

        local targetCFrame = targetRootPart.CFrame
        local newPos
        local dist = CONFIG.AttachDistance

        if CONFIG.Mode == "上方" then
            newPos = (targetCFrame * CFrame.new(0, dist, 0)).Position
