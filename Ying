    local IsBodyPart = function(p) 
        return p:IsA("BasePart") and (p.Name=="Head" or p.Name=="Torso" or p.Name=="Left Arm" or p.Name=="Right Arm" or p.Name=="Left Leg" or p.Name=="Right Leg" or p.Name=="UpperTorso" or p.Name=="LowerTorso") 
