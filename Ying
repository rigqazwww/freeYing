        for _, targetId in ipairs(TARGET_ANIMATION_IDS) do
            if pureId == targetId then return true end
        end
        return false
    end

    local function speedFor(track)
        local len = track.Length
        if not len or len <= 0 then
            return 1000
        end
        return len / Config.Duration
    end

    local function applySpeed(track)
        if not Config.Enabled then return end
        local speed = speedFor(track)
        track:AdjustSpeed(speed)
        task.spawn(function()
            task.wait(0)
            if Config.Enabled and track.IsPlaying then
                track:AdjustSpeed(speed)
            end
        end)
    end

    local function setupAnimator(character)
        local humanoid = character:WaitForChild("Humanoid")
        local animator = humanoid:WaitForChild("Animator")

        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            if matchesTargetAnim(track.Animation and track.Animation.AnimationId) then
                applySpeed(track)
            end
        end

        animator.AnimationPlayed:Connect(function(track)
            if not matchesTargetAnim(track.Animation and track.Animation.AnimationId) then return end
            task.spawn(function()
                local waited = 0
                while track.Length <= 0 and waited < 1 do
                    task.wait(0.01)
                    waited += 0.01
                end
                applySpeed(track)
            end)
        end)
    end

    if LocalPlayer.Character then
        task.spawn(setupAnimator, LocalPlayer.Character)
    end
    LocalPlayer.CharacterAdded:Connect(function(character)
        task.spawn(setupAnimator, character)
    end)

    AnimSpeedTab:Paragraph({
        Title = T("动画加速", "Animation Speed"),
        Desc = T("字面意思", "Literally what it says"),
    })

    AnimSpeedTab:Divider()

    AnimSpeedTab:Toggle({
        Title = T("启用动画加速", "Enable Animation Speed"),
        Desc = T("开关", "Toggle"),
        Value = Config.Enabled,
        Callback = function(state) Config.Enabled = state end,
    })

    AnimSpeedTab:Input({
        Title = T("时长", "Duration"),
        Desc = T("越小越快", "Smaller = faster"),
        Placeholder = "0.001",
        Value = tostring(Config.Duration),
        Callback = function(text)
            local n = tonumber(text)
            if n and n > 0 then
                Config.Duration = n
            end
        end,
    })

    print("[AnimSpeed] Loaded. Monitoring " .. #TARGET_ANIMATION_IDS .. " animations. Duration: " .. Config.Duration .. "s")
end

do
    local Players = game:GetService("Players")
    local LP      = Players.LocalPlayer

    local Config = {
        Cooldown = 0.05,
        Speed    = 20,
        Range    = 100,
        Original = {},
    }

    local function isCooldownKey(name)
        local lk = name:lower()
        return lk:find("cool") or lk:find("delay") or lk:find("interval")
            or lk:find("^cd$") or lk:find("recovery") or lk:find("reload")
    end

    local function isSpeedKey(name)
        local lk = name:lower()
        return lk:find("speed") or lk:find("rate") or lk:find("swing")
            or lk:find("attackspd") or lk:find("attackspeed")
            or lk:find("swiftspeed") or lk:find("quickspeed")
    end

    local function isRangeKey(name)
        local lk = name:lower()
        return lk:find("range") or lk:find("reach") or lk:find("distance")
    end

    local function getAllTools()
        local list = {}
        local char = LP.Character
        if char then
            for _, t in ipairs(char:GetChildren()) do
                if t:IsA("Tool") then table.insert(list, t) end
            end
        end
        local bp = LP:FindFirstChildOfClass("Backpack")
        if bp then
            for _, t in ipairs(bp:GetChildren()) do
                if t:IsA("Tool") then table.insert(list, t) end
            end
        end
        return list
    end

    local function forceReequip()
        local char = LP.Character
        if not char then return false end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local eq = char:FindFirstChildOfClass("Tool")
        if not hum or not eq then return false end
        local name = eq.Name
        pcall(function() hum:UnequipTools() end)
        task.wait(0.25)
        local bp = LP:FindFirstChildOfClass("Backpack")
        if bp then
            local real = bp:FindFirstChild(name)
            if real and real:IsA("Tool") then
                pcall(function() hum:EquipTool(real) end)
                return true
            end
        end
        return false
    end

    local function applyAll()
        local tools = getAllTools()
        if #tools == 0 then
            WindUI:Notify({
                Title = T("失败", "Failed"),
                Content = T("没有任何工具", "No tools found"),
                Duration = 3,
            })
            return
        end

        local nCooldown, nSpeed, nRange = 0, 0, 0
        local toolCount = 0

        local targetSpeed = math.clamp(Config.Speed, 1, 100)
        if Config.Cooldown > 0 then
            targetSpeed = math.clamp(1 / Config.Cooldown, 1, 50)
        end

        for _, t in ipairs(tools) do
            local toolName = t.Name
            if not Config.Original[toolName] then
                Config.Original[toolName] = {}
            end
            local modifiedThisTool = false
            for k, v in pairs(t:GetAttributes()) do
                if type(v) == "number" then
                    local target = nil
                    if isCooldownKey(k) then
                        target = Config.Cooldown
                        nCooldown = nCooldown + 1
                    elseif isSpeedKey(k) then
                        target = targetSpeed
                        nSpeed = nSpeed + 1
                    elseif isRangeKey(k) then
                        target = Config.Range
                        nRange = nRange + 1
                    end
                    if target then
                        if Config.Original[toolName][k] == nil then
                            Config.Original[toolName][k] = v
                        end
                        pcall(function() t:SetAttribute(k, target) end)
                        modifiedThisTool = true
                    end
                end
            end
            if modifiedThisTool then toolCount = toolCount + 1 end
        end

        forceReequip()

        local total = nCooldown + nSpeed + nRange
        if total > 0 then
            WindUI:Notify({
                Title = T("修改成功", "Modified Successfully"),
                Content = T(
                    string.format("%d 个工具 | 冷却 %d + 速度 %d + 范围 %d",
                        toolCount, nCooldown, nSpeed, nRange),
                    string.format("%d tools | Cooldown %d + Speed %d + Range %d",
                        toolCount, nCooldown, nSpeed, nRange)
                ),
                Duration = 4,
            })
        else
            WindUI:Notify({
                Title = T("未找到属性", "No Attributes Found"),
                Content = T("工具没有匹配的冷却/速度/范围属性",
                            "Tools have no matching cooldown/speed/range attributes"),
                Duration = 4,
            })
        end
    end

    local function restoreOriginal()
        local tools = getAllTools()
        local n = 0
        for _, t in ipairs(tools) do
            local rec = Config.Original[t.Name]
            if rec then
                for k, v in pairs(rec) do
                    pcall(function() t:SetAttribute(k, v) end)
                    n += 1
                end
            end
        end
        forceReequip()
        WindUI:Notify({
            Title = T("已恢复", "Restored"),
            Content = T(string.format("还原 %d 个属性", n),
                        string.format("Restored %d attributes", n)),
            Duration = 3,
        })
    end

    AttackSpeedTab:Paragraph({
        Title = T("说明", "Info"),
        Desc = T(
            "一键修改：\n越小 → 越快\n\n0 秒 = 可能被踢\n0.25 秒 = 大部分武器\n0.55 秒 = 小部分武器",
            "One-click modify:\nSmaller → Faster\n\n0s = May get kicked\n0.25s = Most weapons\n0.55s = Some weapons"
        ),
    })

    AttackSpeedTab:Divider()

    AttackSpeedTab:Slider({
        Title = T("冷却", "Cooldown"),
        Desc = T("0 - 2 秒", "0 - 2 seconds"),
        Step = 0.052,
        Value = { Min = 0, Max = 2, Default = Config.Cooldown },
        Callback = function(value)
            Config.Cooldown = tonumber(value) or 0.05
        end,
    })

    AttackSpeedTab:Input({
        Title = T("输入", "Input"),
        Placeholder = "0.25",
        Value = tostring(Config.Cooldown),
        Callback = function(text)
            local n = tonumber(text)
            if n then Config.Cooldown = math.clamp(n, 0, 2) end
        end,
    })

    AttackSpeedTab:Divider()

    AttackSpeedTab:Button({
        Title = T("修改攻速", "Modify Attack Speed"),
        Desc = T("改完点我", "Click me after modifying"),
        Callback = function() applyAll() end,
    })

    AttackSpeedTab:Button({
        Title = T("恢复原值", "Restore Original"),
        Callback = function() restoreOriginal() end,
    })

    print("[Attack Speed] Loaded")
end

