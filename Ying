do
    local ProximityPromptService = game:GetService("ProximityPromptService")
    local Players   = game:GetService("Players")
    local Workspace = game:GetService("Workspace")
    local LP        = Players.LocalPlayer

    local ArrestConfig = {
        Enabled       = false,
        Range         = 100,
        PerPromptCD   = 1.0,
        GlobalCD      = 0.3,
        AutoHold      = true,
        MatchKeywords = { "arrest" },
        AutoEquip     = true,
        ToolKeyword   = "arrest",
        RestoreDelay  = 1.5,
        RemoteTrigger = true,
        ScanInterval  = 30,
        ScanBatch     = 200,
    }

    local State = {
        Prompts      = setmetatable({}, {__mode = "k"}),
        LastTrigger  = {},
        GlobalLast   = 0,
        Holding      = false,
        OriginalTool = nil,
        LastDetected = 0,
        Loop         = true,
        Scanning     = false,
    }

    local function textMatches(prompt)
        local action = prompt.ActionText
        if not action or action == "" then return false end
        action = action:lower():match("^%s*(.-)%s*$") or action
        for _, kw in ipairs(ArrestConfig.MatchKeywords) do
            if action == kw then return true end
        end
        return false
    end

    ProximityPromptService.PromptShown:Connect(function(p)
        if textMatches(p) then State.Prompts[p] = true end
    end)

    ProximityPromptService.PromptHidden:Connect(function(p)
        State.Prompts[p] = nil
        State.LastTrigger[p] = nil
    end)

    local function scanAllAsync()
        if State.Scanning then return end
        State.Scanning = true
        task.spawn(function()
            local ok, list = pcall(function() return Workspace:GetDescendants() end)
            if not ok or not list then
                State.Scanning = false
                return
            end
            local total = #list
            local i = 1
            while i <= total do
                local batchEnd = i + ArrestConfig.ScanBatch - 1
                if batchEnd > total then batchEnd = total end
                for j = i, batchEnd do
                    local obj = list[j]
                    if obj:IsA("ProximityPrompt") and textMatches(obj) then
                        State.Prompts[obj] = true
                    end
                end
                i = batchEnd + 1
                task.wait()
            end
            State.Scanning = false
        end)
    end

    task.spawn(function()
        while State.Loop do
            task.wait(ArrestConfig.ScanInterval)
            if ArrestConfig.Enabled then scanAllAsync() end
        end
    end)

    local function getPromptWorldPos(prompt)
        local obj = prompt.Parent
        if not obj then return nil end
        if obj:IsA("BasePart") then return obj.Position end
        if obj:IsA("Attachment") then return obj.WorldPosition end
        if obj:IsA("Model") then
            local ok, pivot = pcall(function() return obj:GetPivot() end)
            if ok and pivot then return pivot.Position end
        end
        local part = prompt:FindFirstAncestorWhichIsA("BasePart")
        if part then return part.Position end
        return nil
    end

    local function findNearest()
        local char = LP.Character
        if not char then return nil end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return nil end
        local myPos = hrp.Position
        local rangeSq = ArrestConfig.Range * ArrestConfig.Range
        local best, bestD2 = nil, nil
        for prompt in pairs(State.Prompts) do
            if prompt.Parent and prompt.Enabled then
                local pos = getPromptWorldPos(prompt)
                if pos then
                    local dx = pos.X - myPos.X
                    local dy = pos.Y - myPos.Y
                    local dz = pos.Z - myPos.Z
                    local d2 = dx*dx + dy*dy + dz*dz
                    if d2 <= rangeSq and (not bestD2 or d2 < bestD2) then
                        best, bestD2 = prompt, d2
                    end
                end
            end
        end
        return best
    end

    local function isArrestTool(tool)
        if not tool then return false end
        return tool.Name:lower():find(ArrestConfig.ToolKeyword, 1, true) ~= nil
    end

    local function equipArrestTool()
        if not ArrestConfig.AutoEquip then return end
        local char = LP.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        local current = char:FindFirstChildOfClass("Tool")
        if isArrestTool(current) then return end
        if current and not State.OriginalTool then State.OriginalTool = current end
        local bp = LP:FindFirstChildOfClass("Backpack")
        if not bp then return end
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") and isArrestTool(t) then
                pcall(function() hum:EquipTool(t) end)
                return
            end
        end
    end

    local function restoreOriginalTool()
        local orig = State.OriginalTool
        if not orig then return end
        local char = LP.Character
        if not char then State.OriginalTool = nil; return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        local current = char:FindFirstChildOfClass("Tool")
        if current and not isArrestTool(current) then
            State.OriginalTool = nil; return
        end
        State.OriginalTool = nil
        if orig.Parent then pcall(function() hum:EquipTool(orig) end) end
    end

    local function trigger(prompt)
        if State.Holding then return end
        local now = tick()
        if now - State.GlobalLast < ArrestConfig.GlobalCD then return end
        local last = State.LastTrigger[prompt]
        if last and now - last < ArrestConfig.PerPromptCD then return end
        State.GlobalLast = now
        State.LastTrigger[prompt] = now
        State.Holding = true
        if ArrestConfig.RemoteTrigger and type(fireproximityprompt) == "function" then
            task.spawn(function()
                pcall(fireproximityprompt, prompt)
                task.wait(0.05)
                State.Holding = false
            end)
            return
        end
        task.spawn(function()
            pcall(function() prompt:InputHoldBegin() end)
            local hold = ArrestConfig.AutoHold and (prompt.HoldDuration or 0) or 0
            if hold > 0 then task.wait(hold + 0.05) else task.wait(0.05) end
            pcall(function() prompt:InputHoldEnd() end)
            State.Holding = false
        end)
    end

    task.spawn(function()
        while State.Loop do
            task.wait(0.15)
            if ArrestConfig.Enabled then
                local target = findNearest()
                if target then
                    State.LastDetected = tick()
                    equipArrestTool()
                    trigger(target)
                else
                    if State.OriginalTool
                       and tick() - State.LastDetected > ArrestConfig.RestoreDelay then
                        restoreOriginalTool()
                    end
                end
            else
                if State.OriginalTool then restoreOriginalTool() end
            end
        end
    end)

    local ArrestToggle
    local ArrestHotkey

    ArrestToggle = ArrestTab:Toggle({
        Title = T("启用自动逮捕", "Enable Auto Arrest"),
        Desc = T("自动", "Automatic"),
        Value = ArrestConfig.Enabled,
        Callback = function(state)
            ArrestConfig.Enabled = state
            if state then
                scanAllAsync()
            else
                State.LastTrigger = {}
                if State.OriginalTool then restoreOriginalTool() end
            end
            if ArrestHotkey then ArrestHotkey:Refresh() end
        end,
    })

    ArrestHotkey = HotkeyUtil.new({
        Id    = "AutoArrest",
        Title = T("自动逮捕", "Auto Arrest"),
        Slot  = 3,
        OnClick = function()
            ArrestConfig.Enabled = not ArrestConfig.Enabled
            if ArrestConfig.Enabled then
                scanAllAsync()
            else
                State.LastTrigger = {}
                if State.OriginalTool then restoreOriginalTool() end
            end
            if ArrestToggle then pcall(function() ArrestToggle:Set(ArrestConfig.Enabled) end) end
            ArrestHotkey:Refresh()
        end,
        GetActive = function() return ArrestConfig.Enabled end,
    })
    
ArrestTab:Slider({
    Title = T("检测范围", "Detection Range"),
    Desc = T("5 - 500 (studs)", "5 - 500 (studs)"),
    Value = { Min = 5, Max = 500, Default = ArrestConfig.Range },
    Callback = function(val) ArrestConfig.Range = math.floor(val) end,
