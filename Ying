        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            if State.HookActive and getnamecallmethod() == "Raycast" then
                local origin, direction, params = ...
                if params and params.FilterType == Enum.RaycastFilterType.Include
                and isCharFilter(params.FilterDescendantsInstances) then
                    local tPos, tPart
