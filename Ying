        ShowDistance = true,
        ShowCircles  = false,
        ShowDoor     = false,
        AutoScan     = true,
        Color        = Color3.fromRGB(255, 170, 0),
    }

    local tracked = {}

    local function getGui()
        if type(gethui) == "function" then
            local ok, hui = pcall(gethui)
            if ok and hui then return hui end
        end
        return CoreGui
    end

    local function findAdornPart(obj)
        if not obj then return nil end
        if obj:IsA("BasePart") then return obj end
        if obj:IsA("Model") then
            return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
        end
        return obj:FindFirstAncestorWhichIsA("BasePart")
    end

    local function isPumpkinName(name)
        if not name then return false end
        local n = name:match("^ScavengerPumpkin(%d+)$")
        if not n then return false end
        local idx = tonumber(n)
        return idx ~= nil and idx >= 1 and idx <= 20
    end

    local function isCircleName(name)
        return name and name:sub(1, 6) == "Circle"
    end

    local function removeESP(obj)
        local data = tracked[obj]
        if not data then return end
        if data.Highlight and data.Highlight.Parent then
            pcall(function() data.Highlight:Destroy() end)
        end
        if data.Box and data.Box.Parent then
            pcall(function() data.Box:Destroy() end)
        end
        if data.Billboard and data.Billboard.Parent then
            pcall(function() data.Billboard:Destroy() end)
        end
        tracked[obj] = nil
    end

    local function createESP(obj, labelText)
        if not (obj and obj.Parent) then return end
        if tracked[obj] then return end
        local adornPart = findAdornPart(obj)
        if not adornPart then return end

        local hl = Instance.new("Highlight")
        hl.Name                = "_EventESP_HL"
        hl.Adornee             = obj:IsA("Model") and obj or adornPart
        hl.FillColor           = Config.Color
        hl.FillTransparency    = 0.5
        hl.OutlineColor        = Color3.fromRGB(255, 255, 255)
        hl.OutlineTransparency = 0
        hl.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Enabled             = true
        hl.Parent              = adornPart

        local box = Instance.new("BoxHandleAdornment")
        box.Name        = "_EventESP_Box"
        box.Adornee     = adornPart
        box.AlwaysOnTop = true
        box.Size        = adornPart.Size + Vector3.new(0.1, 0.1, 0.1)
        box.Color3      = Config.Color
        box.Transparency= 0.7
        box.ZIndex      = 10
        box.Parent      = getGui()

        local bb = Instance.new("BillboardGui")
        bb.Name         = "_EventESP_BB"
        bb.Adornee      = adornPart
        bb.Size         = UDim2.new(0, 220, 0, 30)
        bb.StudsOffset  = Vector3.new(0, 3, 0)
        bb.AlwaysOnTop  = true
        bb.MaxDistance  = math.huge
        bb.ResetOnSpawn = false
        bb.Parent       = getGui()

        local lbl = Instance.new("TextLabel")
        lbl.Size                   = UDim2.new(1, 0, 1, 0)
        lbl.BackgroundTransparency = 1
        lbl.TextColor3             = Config.Color
        lbl.TextStrokeColor3       = Color3.fromRGB(0, 0, 0)
        lbl.TextStrokeTransparency = 0.35
        lbl.TextSize               = 14
        lbl.Font                   = Enum.Font.SourceSansBold
        lbl.RichText               = true
        lbl.TextXAlignment         = Enum.TextXAlignment.Center
        lbl.Parent                 = bb

        tracked[obj] = {
            Highlight = hl,
            Box       = box,
            Billboard = bb,
            Label     = lbl,
            Part      = adornPart,
            Name      = labelText or obj.Name,
        }
    end

    local function scanAll()
        
        local root = Workspace:FindFirstChild("ScavengerHunt")
        if root then
            for i = 1, 20 do
                local pumpkinName = "ScavengerPumpkin" .. i
                local pumpkin = root:FindFirstChild(pumpkinName)
                if pumpkin then
                    if Config.ShowCircles then
                        local specialCircle = pumpkin:FindFirstChild("Circle.173")
                        if specialCircle then
                            createESP(specialCircle, pumpkinName .. " [目标圈]")
                        else
                            createESP(pumpkin, pumpkinName)
                        end
                    else
                        createESP(pumpkin, pumpkinName)
                    end
                end
            end
        end

        if Config.ShowDoor then
            local ignored = Workspace:FindFirstChild("Ignored")
            if ignored then
                local children = ignored:GetChildren()
                
                for _, obj in ipairs(children) do
                    if obj.Name == "SmallWindowedDoor" or obj.Name == "WindowedDoor" then
                        createESP(obj, obj.Name)
                    end
