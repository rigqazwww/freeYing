do
    local Players = game:GetService("Players")
    local Run     = game:GetService("RunService")
    local UIS     = game:GetService("UserInputService")
    local lp      = Players.LocalPlayer

    local HookState = { Hooked = false, OldNamecall = nil }

    local function installHook()
        if HookState.Hooked then return end
        if type(getrawmetatable) ~= "function" then return end
        local ok, mt = pcall(getrawmetatable, game)
        if not ok or not mt or not mt.__namecall then return end
        pcall(function() setreadonly(mt, false) end)
        local old = mt.__namecall
        HookState.OldNamecall = old
        pcall(function()
            mt.__namecall = newcclosure(function(self, ...)
                if getnamecallmethod() == "FireServer"
                and tostring(self) == "ForceSelfDamage" then
                    return nil
                end
                return old(self, ...)
            end)
        end)
        pcall(function() setreadonly(mt, true) end)
        HookState.Hooked = true
    end

    local function uninstallHook()
        if not HookState.Hooked then return end
        local ok, mt = pcall(getrawmetatable, game)
        if ok and mt and HookState.OldNamecall then
            pcall(function()
                setreadonly(mt, false)
                mt.__namecall = HookState.OldNamecall
                setreadonly(mt, true)
            end)
        end
        HookState.Hooked = false
    end

    local FlyConfig = {
        Enabled = false, Speed = 22, Rise = 30, Fall = 40, Boost = 60,
        MaxY = 100000, MinY = -1000,
    }

    local FlyState = { Conn = nil, Ctrl = nil, Boost = false, VirtualPos = nil }

    local ZERO = Vector3.zero
    local KEY_SPACE   = Enum.KeyCode.Space
    local KEY_SHIFT_L = Enum.KeyCode.LeftShift
    local KEY_SHIFT_R = Enum.KeyCode.RightShift

    local function getControl()
        if FlyState.Ctrl then return FlyState.Ctrl end
        local ok, mod = pcall(function()
            return require(lp.PlayerScripts:WaitForChild("PlayerModule"))
        end)
        if not ok or not mod then return nil end
        local ok2, ctrl = pcall(function() return mod:GetControls() end)
        if not ok2 then return nil end
        FlyState.Ctrl = ctrl
        return ctrl
    end

    local function stopFly()
        if FlyState.Conn then
            FlyState.Conn:Disconnect()
            FlyState.Conn = nil
        end
        FlyState.Boost = false
        FlyState.VirtualPos = nil
        local char = lp.Character
        if char then
            local anim = char:FindFirstChild("Animate")
            if anim then anim.Disabled = false end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                pcall(function()
                    hrp.AssemblyLinearVelocity  = ZERO
                    hrp.AssemblyAngularVelocity = ZERO
                end)
            end
        end
    end

    local function startFly()
        stopFly()
        local char = lp.Character or lp.CharacterAdded:Wait()
        local hrp  = char:WaitForChild("HumanoidRootPart")
        local hum  = char:WaitForChild("Humanoid")
        local anim = char:FindFirstChild("Animate")
        if anim then anim.Disabled = true end

        local ctrl = getControl()
        FlyState.VirtualPos = hrp.Position
        local cachedCam = workspace.CurrentCamera

        FlyState.Conn = Run.PreSimulation:Connect(function(dt)
            if not FlyConfig.Enabled then return end
            if not char.Parent or not hrp.Parent or not hum.Parent then return end
            if dt <= 0 then return end
            if dt > 0.1 then dt = 0.1 end

            if not cachedCam or not cachedCam.Parent then
                cachedCam = workspace.CurrentCamera
                if not cachedCam then return end
            end

            local curPos = hrp.Position
            local vp = FlyState.VirtualPos
            if not vp then
                FlyState.VirtualPos = curPos
            else
                local dx = curPos.X - vp.X
                local dy2 = curPos.Y - vp.Y
                local dz = curPos.Z - vp.Z
                if dx*dx + dy2*dy2 + dz*dz > 400 then
                    FlyState.VirtualPos = curPos
                end
            end
            vp = FlyState.VirtualPos

            local mv = ctrl and ctrl:GetMoveVector() or ZERO
            local hasMove = mv.X*mv.X + mv.Y*mv.Y + mv.Z*mv.Z > 0.0001

            local upDown = 0
            if UIS:IsKeyDown(KEY_SPACE) then upDown = upDown + 1 end
            if UIS:IsKeyDown(KEY_SHIFT_L) or UIS:IsKeyDown(KEY_SHIFT_R) then
                upDown = upDown - 1
            end

            if hasMove or upDown ~= 0 then
                local camCF = cachedCam.CFrame
                local look  = camCF.LookVector
                local right = camCF.RightVector

                local dirX = look.X * -mv.Z + right.X * mv.X
                local dirZ = look.Z * -mv.Z + right.Z * mv.X

                local magSq = dirX*dirX + dirZ*dirZ
                local horizDirX, horizDirZ = 0, 0
                if magSq > 0.0001 then
                    local inv = 1 / math.sqrt(magSq)
                    horizDirX, horizDirZ = dirX * inv, dirZ * inv
                end

                local hSpeed = FlyConfig.Speed
                if FlyState.Boost then hSpeed = hSpeed + FlyConfig.Boost end

                local vSpeed = (upDown >= 0) and FlyConfig.Rise or FlyConfig.Fall
                if FlyState.Boost then vSpeed = vSpeed + FlyConfig.Boost end

                local dirY = look.Y * -mv.Z + right.Y * mv.X
                local verticalMove = dirY + upDown
                if verticalMove > 1 then verticalMove = 1
                elseif verticalMove < -1 then verticalMove = -1 end

                local newY = vp.Y + verticalMove * vSpeed * dt
                if newY > FlyConfig.MaxY then newY = FlyConfig.MaxY
                elseif newY < FlyConfig.MinY then newY = FlyConfig.MinY end

                FlyState.VirtualPos = Vector3.new(
                    vp.X + horizDirX * hSpeed * dt,
                    newY,
                    vp.Z + horizDirZ * hSpeed * dt
                )
            end

            vp = FlyState.VirtualPos
            local ddx = curPos.X - vp.X
            local ddy = curPos.Y - vp.Y
            local ddz = curPos.Z - vp.Z
            if ddx*ddx + ddy*ddy + ddz*ddz > 2.5e-7 then
                local rot = hrp.CFrame - curPos
                hrp.CFrame = CFrame.new(vp) * rot

                local lv = hrp.AssemblyLinearVelocity
                if lv.X ~= 0 or lv.Y ~= 0 or lv.Z ~= 0 then
                    hrp.AssemblyLinearVelocity = ZERO
                end
                local av = hrp.AssemblyAngularVelocity
                if av.X ~= 0 or av.Y ~= 0 or av.Z ~= 0 then
                    hrp.AssemblyAngularVelocity = ZERO
                end
            end
        end)
    end

    local function setFlyEnabled(v)
        v = v and true or false
        if v == FlyConfig.Enabled then return end
        FlyConfig.Enabled = v
        if v then
            installHook()
            startFly()
        else
            stopFly()
            uninstallHook()
        end
    end

    local FlyToggle
    local FlySpeedInput, FlyRiseInput, FlyFallInput, FlyBoostInput
    local FlyMaxYInput, FlyMinYInput
