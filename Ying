    local lastSongTitle, lastSongDesc, lastLyricText, lastTimeText, lastPct = "", "", "", "", -1
    local lyricNotifyLast = ""
    local paragraphOK = true

    local function trySetPara(para, kind, val)
        if not para then return false end
        local method = (kind == "Title") and "SetTitle" or "SetDesc"
        local ok = pcall(function() para[method](para, val) end)
        if ok then return true end
        local ok2 = pcall(function() para[kind] = val end)
        return ok2
    end

    local function updateMusicUI()
        
        local title, desc
        if State.CurrentSong then
            title = "♪ " .. State.CurrentSong.name
            desc  = artistNameOf(State.CurrentSong)
        else
            title = "♪ " .. T("未在播放", "Not Playing")
            desc  = T("搜索或选择歌曲开始播放", "Search or pick a song to play")
        end
        if title ~= lastSongTitle then
            if not trySetPara(nowPara, "Title", title) then paragraphOK = false end
            lastSongTitle = title
        end
        if desc ~= lastSongDesc then
            if not trySetPara(nowPara, "Desc", desc) then paragraphOK = false end
            lastSongDesc = desc
        end

        local lyricText = "♪"
        if State.CurLyricIdx >= 1 and State.CurLyricIdx <= #State.Lyrics then
            lyricText = State.Lyrics[State.CurLyricIdx].text
        elseif #State.Lyrics > 0 and Audio.IsPlaying then
            lyricText = State.Lyrics[1].text
        elseif #State.Lyrics == 0 and State.CurrentSong then
            if Audio.TimeLength == 0 then
                lyricText = T("加载中…", "Loading…")
            else
                lyricText = T("该歌曲暂无歌词", "No lyrics")
            end
        end
        if lyricText ~= lastLyricText then
            if paragraphOK then
                trySetPara(lyricPara, "Title", "♪ " .. T("歌词", "Lyrics"))
                trySetPara(lyricPara, "Desc", lyricText)
            elseif lyricText ~= lyricNotifyLast and lyricText ~= "♪"
                and lyricText ~= T("该歌曲暂无歌词", "No lyrics")
                and lyricText ~= T("加载中…", "Loading…") then
                lyricNotifyLast = lyricText
                notify("♪", lyricText, 2)
            end
            lastLyricText = lyricText
        end

        
        local timeText = formatTime(Audio.TimePosition) .. " / " .. formatTime(Audio.TimeLength)
        if timeText ~= lastTimeText then
            trySetPara(timePara, "Title", timeText)
            pcall(function() progressSlider:SetDesc(timeText) end)
            lastTimeText = timeText
        end

       
        local pct = 0
        if Audio.TimeLength > 0 then
            pct = math.clamp(Audio.TimePosition / Audio.TimeLength, 0, 1) * 100
        end
        if math.abs(pct - lastPct) > 1 then
            progressSeeking = true
            pcall(function() progressSlider:Set(math.round(pct)) end)
            progressSeeking = false
            lastPct = pct
        end
    end

    
    task.spawn(function()
        local lastTick = 0
