                        and string.format('<font color="#94a3b8">|</font> %s', ht) or ht)
                end
                local finalText = table.concat(parts, ' ')
                if data.LastText ~= finalText then
                    data.LastText = finalText
                    data.NameLabel.Text = finalText
                end
            end
