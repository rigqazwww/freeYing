local HotkeyUtil = (function()
    local UIS = game:GetService("UserInputService")

    local function getGlobal()
        if type(getgenv) == "function" then
            local ok, g = pcall(getgenv)
            if ok and type(g) == "table" then return g end
        end
        return _G
    end

    local G = getGlobal()
    if type(G.PAL_HotkeyStore) ~= "table" then
        G.PAL_HotkeyStore = {}
    end
    local Store = G.PAL_HotkeyStore

    local function getGuiParent()
        if type(gethui) == "function" then
            local ok, hui = pcall(gethui)
            if ok and hui then return hui end
        end
        local ok2, cg = pcall(function() return game:GetService("CoreGui") end)
        if ok2 and cg then
            local probe = Instance.new("Folder")
            local ok3 = pcall(function() probe.Parent = cg end)
            probe:Destroy()
            if ok3 then return cg end
        end
        return game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
    end

    local function viewportSize()
        local cam = workspace.CurrentCamera
        if cam then return cam.ViewportSize end
        return Vector2.new(1280, 720)
    end

    local Class = {}
    Class.__index = Class

    function Class.new(opts)
        local self = setmetatable({}, Class)
        self.Id        = opts.Id or "Default"
        self.Title     = opts.Title or T("快捷键", "Hotkey")
        self.Slot      = opts.Slot or 0
        self.Visible   = false
        self.Locked    = false
        self.OnClick   = opts.OnClick
        self.GetActive = opts.GetActive or function() return false end
        self.Conn      = {}

        local gui = Instance.new("ScreenGui")
        gui.Name = "PAL_Hotkey_" .. self.Id
        gui.ResetOnSpawn = false
        gui.IgnoreGuiInset = true
        gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        gui.DisplayOrder = 999
        pcall(function() if syn and syn.protect_gui then syn.protect_gui(gui) end end)
        pcall(function() if protectgui then protectgui(gui) end end)
        gui.Parent = getGuiParent()
        self.Gui = gui

        local btn = Instance.new("TextButton")
        btn.Name = "HotkeyBtn"
        btn.Size = UDim2.fromOffset(140, 46)
        btn.BackgroundColor3 = Color3.fromRGB(26, 26, 30)
        btn.BorderSizePixel = 0
        btn.AutoButtonColor = false
        btn.Text = ""
        btn.Visible = false
        btn.Active = true
        btn.Parent = gui
        self.Button = btn

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 8)
        corner.Parent = btn

        local stroke = Instance.new("UIStroke")
        stroke.Color = Color3.fromRGB(80, 80, 90)
        stroke.Thickness = 1.5
        stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        stroke.Parent = btn
        self.Stroke = stroke

        local title = Instance.new("TextLabel")
        title.BackgroundTransparency = 1
        title.Position = UDim2.new(0, 10, 0, 5)
        title.Size = UDim2.new(1, -20, 0, 17)
        title.Font = Enum.Font.GothamBold
        title.TextSize = 13
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.TextColor3 = Color3.fromRGB(240, 240, 245)
        title.Text = self.Title
        title.Parent = btn

        local state = Instance.new("TextLabel")
        state.BackgroundTransparency = 1
        state.Position = UDim2.new(0, 10, 0, 23)
        state.Size = UDim2.new(1, -20, 0, 14)
        state.Font = Enum.Font.Gotham
        state.TextSize = 11
        state.TextXAlignment = Enum.TextXAlignment.Left
        state.TextColor3 = Color3.fromRGB(150, 150, 160)
        state.Text = T("已关闭", "OFF")
        state.Parent = btn
        self.StateLabel = state

        local vp = viewportSize()
        local saved = Store[self.Id]
        if type(saved) == "table" and #saved >= 2 then
            btn.Position = UDim2.fromOffset(saved[1], saved[2])
        else
            btn.Position = UDim2.fromOffset(
                math.max(0, vp.X - 170),
                math.max(0, math.floor(vp.Y * 0.42) + self.Slot * 56)
            )
        end

        local pressing, dragging, moved = false, false, false
        local dragStart, startPos

        self.Conn[#self.Conn + 1] = btn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                pressing = true
                moved    = false
                dragStart = input.Position
                startPos  = btn.Position
                dragging  = not self.Locked
            end
        end)

        self.Conn[#self.Conn + 1] = UIS.InputChanged:Connect(function(input)
            if not pressing or not dragging then return end
            if input.UserInputType ~= Enum.UserInputType.MouseMovement
            and input.UserInputType ~= Enum.UserInputType.Touch then return end

            local delta = input.Position - dragStart
            if not moved and (math.abs(delta.X) > 3 or math.abs(delta.Y) > 3) then
                moved = true
            end
            if moved then
                btn.Position = UDim2.fromOffset(
                    math.floor(startPos.X.Offset + delta.X),
                    math.floor(startPos.Y.Offset + delta.Y)
                )
            end
        end)

        self.Conn[#self.Conn + 1] = UIS.InputEnded:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
            if not pressing then return end

            pressing = false
            dragging = false

            if moved then
                self:ClampToScreen()
                self:Save()
            else
                if self.OnClick then
                    local ok, err = pcall(self.OnClick)
                    if not ok then
                        warn("[Hotkey] Callback error: " .. tostring(err))
                    end
                end
                self:Refresh()
            end
        end)

        self:Refresh()
        return self
    end

    function Class:ClampToScreen()
        local vp = viewportSize()
        local sz = self.Button.AbsoluteSize
        if sz.X <= 0 or sz.Y <= 0 then
            sz = Vector2.new(self.Button.Size.X.Offset, self.Button.Size.Y.Offset)
        end
        local p = self.Button.Position
        self.Button.Position = UDim2.fromOffset(
            math.clamp(p.X.Offset, 0, math.max(0, vp.X - sz.X)),
            math.clamp(p.Y.Offset, 0, math.max(0, vp.Y - sz.Y))
        )
    end

    function Class:Save()
        local p = self.Button.Position
        Store[self.Id] = { p.X.Offset, p.Y.Offset }
    end

    function Class:Refresh()
        local btn = self.Button
        if not btn then return end

        local active = false
        local ok, res = pcall(self.GetActive)
        if ok then active = res and true or false end

        if active then
            btn.BackgroundColor3   = Color3.fromRGB(48, 20, 22)
            self.Stroke.Color      = Color3.fromRGB(255, 70, 70)
            self.StateLabel.TextColor3 = Color3.fromRGB(255, 120, 120)
        else
            btn.BackgroundColor3   = Color3.fromRGB(26, 26, 30)
            self.Stroke.Color      = Color3.fromRGB(80, 80, 90)
            self.StateLabel.TextColor3 = Color3.fromRGB(150, 150, 160)
        end

        local status = active and T("已开启", "ON") or T("已关闭", "OFF")
        local suffix
        if self.Locked then
            suffix = T(" · 位置已锁定", " · Position Locked")
        else
            suffix = T(" · 可拖动", " · Draggable")
        end
        self.StateLabel.Text = status .. suffix

        btn.Visible = self.Visible
    end

    function Class:SetVisible(v)
        self.Visible = v and true or false
        if self.Visible then
            self.Button.Visible = true
            self:ClampToScreen()
        end
        self:Refresh()
    end

    function Class:SetLocked(v)
        self.Locked = v and true or false
        self:Refresh()
    end

