do
    local Players           = game:GetService("Players")
    local RunService        = game:GetService("RunService")
    local UIS               = game:GetService("UserInputService")
    local Workspace         = game:GetService("Workspace")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local LP                = Players.LocalPlayer

    local SA = { Enabled = true, Wallbang = false, WallCheck = true }
    local ST = { Target = nil, Name = "", LastScan = 0 }

    local NAMES = {
        ["Taser"] = true, ["Handheld Taser"] = true,
        ["Peppergun"] = true, ["Ignotus Laser Pistol"] = true,
    }

    local function getTool()
        local c = LP.Character
        if not c then return nil end
        for _, t in ipairs(c:GetChildren()) do
            if t:IsA("Tool") and NAMES[t.Name] then return t end
        end
        return nil
    end

    local visP = RaycastParams.new()
    visP.FilterType  = Enum.RaycastFilterType.Exclude
    visP.IgnoreWater = true

    local function isVisible(part, ch, from)
        local cam = Workspace.CurrentCamera
        if not cam then return false end
        local f = {}
        local mc = LP.Character
        if mc  then f[#f+1] = mc  end
        if cam then f[#f+1] = cam end
        if ch  then f[#f+1] = ch  end
        visP.FilterDescendantsInstances = f
        local fromPos = from or cam.CFrame.Position
        local ok, r = pcall(function()
            return Workspace:Raycast(fromPos, part.Position - fromPos, visP)
        end)
        if not ok then return false end
        if not r then return true end
        return r.Instance == part or (ch and r.Instance:IsDescendantOf(ch))
    end

    local function scan()
        if not SA.Enabled or not getTool() then
            ST.Target = nil; ST.Name = ""
            return
        end
        local cam = Workspace.CurrentCamera
        if not cam then return end
        local mouse  = UIS:GetMouseLocation()
        local best, bestName, bestD2 = nil, "", math.huge
        local need   = SA.WallCheck and not SA.Wallbang
        local camPos = cam.CFrame.Position

        for _, pl in ipairs(Players:GetPlayers()) do
            if pl ~= LP and pl.Team
            and (pl.Team.Name == "PATIENT" or pl.Team.Name == "PATIENTS") then
                local ch = pl.Character
                if ch and ch.Parent then
                    local tg = pl:GetAttribute("IsTagged")
                    if tg == nil then tg = ch:GetAttribute("IsTagged") end
                    if tg == true then
                        local rg = pl:GetAttribute("Ragdolled")
                        if rg == nil then rg = ch:GetAttribute("Ragdolled") end
                        if rg ~= true then
                            local hum = ch:FindFirstChildOfClass("Humanoid")
                            if hum and hum.Health > 0 then
                                local h = ch:FindFirstChild("HumanoidRootPart")
                                 or ch:FindFirstChild("UpperTorso")
                                  or ch:FindFirstChild("Torso")
                                if h then
                                    local sp, on = cam:WorldToScreenPoint(h.Position)
                                    local d2
                                    if on then
                                        local dx, dy = sp.X - mouse.X, sp.Y - mouse.Y
                                        d2 = dx*dx + dy*dy
                                    else
                                        local dp = h.Position - camPos
                                        d2 = 1e8 + dp:Dot(dp)
                                    end
                                    if d2 < bestD2 then
                                        if (not need) or isVisible(h, ch, camPos) then
                                            best, bestD2, bestName = h, d2, (pl.DisplayName or pl.Name)
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        ST.Target = best
        ST.Name   = bestName
    end

    RunService.Heartbeat:Connect(function()
        local n = os.clock()
        if n - ST.LastScan >= 0.05 then
            ST.LastScan = n
            pcall(scan)
        end
    end)

    task.spawn(function()
        pcall(function()
            local svc = ReplicatedStorage:WaitForChild("Service", 10)
            if not svc then return end
            local rc = svc:WaitForChild("Raycast", 10)
            if not rc then return end
            local mod = require(rc)
            if type(mod) ~= "table" then return end

            if type(mod.Fire) == "function" then
                local orig = mod.Fire
                local function hooked(o, d, p)
                    if SA.Enabled and ST.Target and ST.Target.Parent and getTool() then
                        local tp = ST.Target
                        if SA.Wallbang then
                            return { Instance = tp, Position = tp.Position,
                                     Distance = (tp.Position - o).Magnitude,
                                     Material = Enum.Material.Plastic,
                                     Normal   = Vector3.new(0, 1, 0) }
                        end
                        local mag = (typeof(d) == "Vector3" and d.Magnitude > 0) and d.Magnitude or 1000
                        local nd  = (tp.Position - o).Unit * mag
                        return orig(o, nd, p)
                    end
                    return orig(o, d, p)
                end
                if typeof(hookfunction) == "function" then
                    mod.Fire = hookfunction(orig, newcclosure(hooked))
                else
                    mod.Fire = hooked
                end
            end

            if type(mod.IsObstructed) == "function" then
                local orig = mod.IsObstructed
                local function hooked(a, b, c, d)
                    if SA.Enabled and SA.Wallbang and ST.Target and ST.Target.Parent and getTool() then
                        return false, { Instance = nil, Normal = Vector3.new(0, 1, 0),
                                        Position = b or a,
                                        Distance = (b and (b - a).Magnitude or 1),
                                        Material = Enum.Material.Air }
                    end
                    return orig(a, b, c, d)
                end
                if typeof(hookfunction) == "function" then
                    mod.IsObstructed = hookfunction(orig, newcclosure(hooked))
                else
                    mod.IsObstructed = hooked
                end
            end
        end)

        pcall(function()
            local svc = ReplicatedStorage:WaitForChild("Service", 10)
            if not svc then return end
            local uis = svc:WaitForChild("UserInputService", 10)
            if not uis then return end
            local mod = require(uis)
            if type(mod) ~= "table" then return end
            if type(mod.GetMouseHit) ~= "function" then return end

            local orig = mod.GetMouseHit
            local function hooked()
                if SA.Enabled and ST.Target and ST.Target.Parent and getTool() then
                    local tp = ST.Target
                    local cam = Workspace.CurrentCamera
                    local camPos = cam and cam.CFrame.Position or Vector3.zero
                    return { Instance = tp, Position = tp.Position,
                             Distance = (tp.Position - camPos).Magnitude,
                             Material = Enum.Material.Plastic,
                             Normal   = Vector3.new(0, 1, 0) }
                end
                return orig()
            end
            if typeof(hookfunction) == "function" then
                mod.GetMouseHit = hookfunction(orig, newcclosure(hooked))
            else
                mod.GetMouseHit = hooked
            end
        end)
    end)

    pcall(function()
        if KillTab and KillTab.Toggle then
            KillTab:Divider()
            KillTab:Toggle({
                Title = T("电击枪静默瞄准", "Taser Silent Aim"),
                Desc  = T("自动瞄准敌对",
                          "Auto-redirect tagged PATIENT"),
                Value = SA.Enabled,
                Callback = function(s)
                    SA.Enabled = s
                    if not s then ST.Target = nil; ST.Name = "" end
                end,
            })
            KillTab:Toggle({
                Title = T("wallbang", "Wallbang"),
                Desc  = T("无视墙体", "ignores walls"),
                Value = SA.Wallbang,
                Callback = function(s) SA.Wallbang = s end,
            })
            KillTab:Toggle({
                Title = T("可见检查", "visible Check"),
                Desc  = T("要求目标可见",
                          "Require visible "),
                Value = SA.WallCheck,
                Callback = function(s) SA.WallCheck = s end,
            })
        end
    end)

    getgenv().Ying_SilentAimState  = ST
    getgenv().Ying_SilentAimConfig = SA

    print("[Silent Aim] Loaded")
end

