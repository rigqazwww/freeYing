local gpBackup = {}
local gpConn = nil

local function applyGP(inst)
    if not inst then return end
    for _, d in ipairs(inst:GetDescendants()) do
        if d:IsA("BoolValue") then
            if gpBackup[d] == nil then gpBackup[d] = d.Value end
            if d.Value ~= true then pcall(function() d.Value = true end) end

        elseif d:IsA("NumberValue") or d:IsA("IntValue") then
            if gpBackup[d] == nil then gpBackup[d] = d.Value end
            if d.Value <= 0 then pcall(function() d.Value = 1 end) end

        elseif d:IsA("StringValue") then
            if gpBackup[d] == nil then gpBackup[d] = d.Value end
        end
    end
    
    for k, v in pairs(inst:GetAttributes()) do
        if type(v) == "boolean" then
            pcall(function() inst:SetAttribute(k, true) end)
        elseif type(v) == "number" and v <= 0 then
            pcall(function() inst:SetAttribute(k, 1) end)
        end
    end
end

local function startGPSpoof()
    local cfg = LP:FindFirstChild("Configuration_GamepassData") or LP:WaitForChild("Configuration_GamepassData", 5)
    if not cfg then
        WindUI:Notify({ Title = "失败", Content = "未数据", Duration = 3 })
        return false
    end
    
    applyGP(cfg)
    gpConn = cfg.DescendantAdded:Connect(function()
        task.wait(0)
        applyGP(cfg)
    end)
    return true
end

local function stopGPSpoof()
    if gpConn then gpConn:Disconnect(); gpConn = nil end
    for inst, v in pairs(gpBackup) do
        pcall(function()
            if inst.Parent then inst.Value = v end
        end)
    end
    gpBackup = {}
end

