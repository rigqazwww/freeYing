task.spawn(function()
    local StarterPlayer = game:GetService("StarterPlayer")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local Players = game:GetService("Players")
    local LP = Players.LocalPlayer
    
    local forbiddenRemotes = {
        ["ActionEvent"] = true,
        ["BadActionEvent"] = true
    }

    local function is32CharHash(str)
        return string.match(str, "^%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x$") ~= nil
    end

    local function cleanNow()
        
        local scriptContainers = {
            StarterPlayer:FindFirstChild("StarterPlayerScripts"),
            StarterPlayer:FindFirstChild("StarterCharacterScripts"),
            LP:FindFirstChild("PlayerScripts"),
            LP.Character
        }

        for _, container in ipairs(scriptContainers) do
            if container then
                for _, child in ipairs(container:GetChildren()) do
                    if child:IsA("LocalScript") or child:IsA("ModuleScript") or child:IsA("Script") then
                        if is32CharHash(child.Name) then
                            pcall(function()
                                if child:IsA("LocalScript") or child:IsA("Script") then child.Disabled = true end
                                child:Destroy()
                            end)
                            print("脚本: " .. child.Name)
                        end
                    end
                end
            end
        end

        --执行后摧毁特定文件
        local remoteFolder = ReplicatedStorage:FindFirstChild("Remote")
        if remoteFolder then
            for name, _ in pairs(forbiddenRemotes) do
                local targetRemote = remoteFolder:FindFirstChild(name)
                if targetRemote then
                    pcall(function() targetRemote:Destroy() end)
                    print("摧毁" .. name)
                end
            end
        end
    end

    local function bindContainer(container)
        if not container then return end
        container.ChildAdded:Connect(function(child)
            
            if child:IsA("LocalScript") or child:IsA("ModuleScript") or child:IsA("Script") then
                if is32CharHash(child.Name) then
                    task.wait(0.1)
                    pcall(function()
                        if child:IsA("LocalScript") or child:IsA("Script") then child.Disabled = true end
                        child:Destroy()
                    end)
                    print("脚本: " .. child.Name)
                end
            end
        end)
    end

    local function bindRemote()
        local remoteFolder = ReplicatedStorage:FindFirstChild("Remote")
        if remoteFolder then
            remoteFolder.ChildAdded:Connect(function(child)
                if forbiddenRemotes[child.Name] then
                    task.wait(0.1)
                    pcall(function() child:Destroy() end)
                    print("摧毁 " .. child.Name)
                end
            end)
        end
    end

    bindContainer(StarterPlayer:FindFirstChild("StarterPlayerScripts"))
    bindContainer(StarterPlayer:FindFirstChild("StarterCharacterScripts"))
    bindContainer(LP:FindFirstChild("PlayerScripts"))
    bindRemote()
    
    LP.CharacterAdded:Connect(function(char)
        task.wait(0.5)
        cleanNow()
        bindContainer(char)
    end)

    cleanNow()

    while true do
        task.wait(1.5)
        pcall(cleanNow)
    end
end)

