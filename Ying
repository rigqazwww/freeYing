local _AD_W = {}
_AD_W.__index = _AD_W
local function _adTry(obj, m, ...)
    if not obj then return false end
    local ok, fn = pcall(function() return obj[m] end)
    if ok and type(fn) == "function" then return pcall(fn, obj, ...) end
    return false
end
local function _adWrap(c)
    return setmetatable({_kind=c.kind,_ctrl=c.ctrl,_value=c.value,_onSet=c.onSet,
                         _onRef=c.onRef,_onSV=c.onSV}, _AD_W)
end
function _AD_W:Set(v)
    self._value = v if self._onSet then pcall(self._onSet, v) end
    if _adTry(self._ctrl,"SetValue",v) then return end
    _adTry(self._ctrl,"Set",v)
end
function _AD_W:Refresh() if self._onRef then pcall(self._onRef) end end
function _AD_W:SetValues(l)
    if self._onSV then pcall(self._onSV,l) end
    _adTry(self._ctrl,"SetValues",l) _adTry(self._ctrl,"Refresh",l)
end
function _AD_W:SetVisible(v)
    for _,k in ipairs({"Frame","Holder","Main","Container","Object","Root"}) do
        local ok,inst = pcall(function() return self._ctrl[k] end)
        if ok and typeof(inst)=="Instance" then pcall(function() inst.Visible=v end) return end
    end
    local ok,list = pcall(function() return self._ctrl.UIElements end)
    if ok and type(list)=="table" then
        for _,inst in pairs(list) do
            if typeof(inst)=="Instance" and inst:IsA("GuiObject") then pcall(function() inst.Visible=v end) return end
        end
    end
end
function _AD_W:SetLocked(v) _adTry(self._ctrl,"SetLocked",v) _adTry(self._ctrl,"SetEnabled",not v) end
function _AD_W:SetDesc(s) _adTry(self._ctrl,"SetDesc",s) _adTry(self._ctrl,"SetDescription",s) end
function _AD_W:ResetPosition() _adTry(self._ctrl,"ResetPosition") end
function _AD_W:GetValue() return self._value end

local _AD_T = {}
_AD_T.__index = _AD_T
local _adSeq = 0
local function _adNext() _adSeq = _adSeq + 1 return _adSeq end

function _AD_T:_gb()
    if self._cur then return self._cur end
    self._n = (self._n or 0) + 1
    local left = (self._n % 2 == 1)
    local fn = left and self._tab.AddLeftGroupbox or self._tab.AddRightGroupbox
    local ok, gb = pcall(function() return fn(self._tab, {Name="区域"..self._n, Icon="list"}) end)
    if not ok or not gb then
        fn = left and self._tab.AddRightGroupbox or self._tab.AddLeftGroupbox
        local o2, g2 = pcall(function() return fn(self._tab, {Name="区域"..self._n, Icon="list"}) end)
        if not o2 or not g2 then return nil end
        gb = g2
    end
    self._cur = gb
    return gb
end

function _AD_T:Divider()
    self._cur = nil
    self:_gb()
    return _adWrap({kind="Divider"})
end

function _AD_T:Toggle(o)
    o = o or {}
    local gb = self:_gb()
    if not gb then return _adWrap({kind="Toggle",value=o.Value}) end
    local ok, c = pcall(function()
        return gb:CreateToggle({
            Name = tostring(o.Title or "开关"),
            CurrentValue = o.Value == true,
            Flag = "A"..self._id.."T".._adNext(),
            Callback = function(v) if o.Callback then pcall(o.Callback,v) end end,
        })
    end)
    if not ok then print("[adapter] Toggle 失败: "..tostring(o.Title).." · "..tostring(c)) return _adWrap({kind="Toggle",value=o.Value}) end
    return _adWrap({kind="Toggle",ctrl=c,value=o.Value,onSet=o.Callback})
end

function _AD_T:Slider(o)
    o = o or {}
    local gb = self:_gb()
    if not gb then return _adWrap({kind="Slider"}) end
    local v = o.Value
    local mn,mx,dv
    if type(v)=="table" then mn,mx,dv = tonumber(v.Min) or 0, tonumber(v.Max) or 100, tonumber(v.Default) or 0
    else mn,mx,dv = 0,100,tonumber(v) or 0 end
    if mx <= mn then mx = mn + 1 end
    local inc = tonumber(o.Step) or 1 if inc <= 0 then inc = 1 end
    local ok, c = pcall(function()
        return gb:CreateSlider({
            Name = tostring(o.Title or "滑条"),
            Range = {mn,mx}, Increment = inc, CurrentValue = dv,
            Flag = "A"..self._id.."S".._adNext(),
            Callback = function(x) if o.Callback then pcall(o.Callback,x) end end,
        })
    end)
    if not ok then print("[adapter] Slider 失败: "..tostring(o.Title).." · "..tostring(c)) return _adWrap({kind="Slider",value=dv}) end
    return _adWrap({kind="Slider",ctrl=c,value=dv,onSet=o.Callback})
end

