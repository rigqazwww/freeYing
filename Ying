    end

    local refCache = setmetatable({}, {__mode = "k"})
    local function GetRefs(model)
        local e = refCache[model]
        if e and e.hum.Parent and e.root.Parent then return e.hum, e.root end
        local hum = model:FindFirstChildOfClass("Humanoid")
        if not hum then return nil end
        local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") or model.PrimaryPart
        if not root then return nil end
        refCache[model] = {hum = hum, root = root}
        return hum, root
    end

