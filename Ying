    local function autoFlyTo(target, speed)
        speed = speed or EscapeConfig.Speed
        stopAutoFly()

        local char = State.Character
        if not (char and char.Parent) then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local anim = char:FindFirstChild("Animate")
        if anim then
            anim.Disabled = true
            State.CurrentAnim = anim
        end

        local virtualPos = hrp.Position
        local arrived = false

        State.CurrentFlyConn = RunService.PreSimulation:Connect(function(dt)
            if arrived then return end
            local c = State.Character
            if not (c and c.Parent) then
                arrived = true
                stopAutoFly()
                return
            end
            local r = c:FindFirstChild("HumanoidRootPart")
            if not r then
                arrived = true
                stopAutoFly()
                return
            end
            if dt <= 0 then return end
            if dt > 0.1 then dt = 0.1 end

            local curPos = r.Position
            local dx = curPos.X - virtualPos.X
            local dy = curPos.Y - virtualPos.Y
            local dz = curPos.Z - virtualPos.Z
            if dx*dx + dy*dy + dz*dz > 400 then
                virtualPos = curPos
            end

            local diff = target - virtualPos
            local dist = diff.Magnitude
            if dist < 5 then
                arrived = true
                r.AssemblyLinearVelocity  = Vector3.zero
                r.AssemblyAngularVelocity = Vector3.zero
                stopAutoFly()
                return
            end

            local step = math.min(dist, speed * dt)
            virtualPos = virtualPos + diff.Unit * step

            local rot = r.CFrame - curPos
            r.CFrame = CFrame.new(virtualPos) * rot
            r.AssemblyLinearVelocity  = Vector3.zero
            r.AssemblyAngularVelocity = Vector3.zero
        end)

        while not arrived and State.Running do
            task.wait()
        end
    end

